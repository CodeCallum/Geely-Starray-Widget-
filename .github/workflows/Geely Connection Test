
name: Geely Connection Test

on:
  workflow_dispatch:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Check Geely APAC servers
        run: |
          echo "Checking Geely login server..."
          curl -sS -o /dev/null -w "Login server HTTP: %{http_code}\n" https://api.ecloudkr.com/
          echo "Checking Geely vehicle server..."
          curl -sS -o /dev/null -w "Vehicle server HTTP: %{http_code}\n" https://apis.ecloudkr.com/
